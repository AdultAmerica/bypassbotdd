# Telegram bot token from @BotFather
TELEGRAM_TOKEN=

# API key for the bypass service
BYPASS_API_KEY=

# Target channel/chat ID to post results (e.g. -1001234567890)
TARGET_CHAT_ID=

# Bypass API request timeout in milliseconds (default: 15000)
API_TIMEOUT=15000

# Per-user cooldown between requests in milliseconds (default: 5000)
COOLDOWN_MS=5000
